{
	frankenphp
	admin off
	order php_server before file_server
}

# The one public address (SITE_ADDRESS is PUBLIC_URL, or just :80 behind a tunnel, which already brings https). The API (and the embed script) is PHP; everything else is the dashboard.
{$SITE_ADDRESS} {
	root * /app/public
	encode zstd gzip

	request_body {
		max_size 25MB
	}

	@backend path /api/* /embed.js
	handle @backend {
		@script path /embed.js
		header @script Cache-Control "public, max-age=300"
		php_server
	}

	handle {
		reverse_proxy frontend:3000
	}
}

# Only for the container's own health check: it is not published.
http://:8081 {
	root * /app/public
	php_server
}
