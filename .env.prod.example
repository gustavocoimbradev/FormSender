# Production settings. `make prod` creates .env.prod from this file the first time and fills in the secrets.

# The address people will use, with https://. Its domain must point at this server and ports 80 and 443 must be open:
# the HTTPS certificate is asked for and renewed by itself. To try it on your own computer: http://localhost
PUBLIC_URL=https://forms.example.com

# Generated for you. Keep them: the key encrypts the saved SMTP password, so a new key means typing it again.
APP_KEY=
DB_PASSWORD=

# Optional. Days to keep received messages (0 keeps everything), the largest attachment in KB, and requests per minute per visitor.
SUBMISSION_RETENTION_DAYS=0
ATTACHMENT_MAX_KILOBYTES=5120
API_RATE_LIMIT=60
