# Production settings. `make prod` creates .env.prod from this file the first time and fills in the secrets.

# The address people will use. `make prod` asks for it the first time and writes it here; change it here (then run
# make prod) or with `make prod-setup`. A domain (https://forms.mycompany.com) must point at this server with ports 80
# and 443 open: the HTTPS certificate is asked for and renewed by itself. An IP address or localhost works over
# plain http (http://203.0.113.5).
PUBLIC_URL=https://forms.example.com

# Generated for you. Keep them: the key encrypts the saved SMTP password, so a new key means typing it again.
APP_KEY=
DB_PASSWORD=

# Optional. Days to keep received messages (0 keeps everything), the largest attachment in KB, and requests per minute per visitor.
SUBMISSION_RETENTION_DAYS=0
ATTACHMENT_MAX_KILOBYTES=5120
API_RATE_LIMIT=60

# Optional. For a server at home (or any machine without a fixed IP or open ports): a Cloudflare Tunnel token.
# With it, make prod starts the tunnel, keeps ports 80 and 443 on this machine only and PUBLIC_URL must be the https
# address you gave the tunnel (https://forms.mycompany.com). Leave empty for the normal setup.
TUNNEL_TOKEN=
